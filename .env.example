# Framework behavior / cookie security only (production | development).
NODE_ENV=development
TLEF_GRASP_PORT=8070

# The purpose of this constant is to grant users who are not faculty members with faculty role. The list includes user PUIDs separated by comma.
APP_ADMINISTRATOR=11223344,11223345

# --- Session Management ---
# A long, random string used to sign the session ID cookie.
SESSION_SECRET=your_session_secret_here
# Session timeout in milliseconds (Default: 7200000 = 2 hours)
SESSION_TIMEOUT_MS=7200000

# --- SAML (Single Sign-On / Single Log-Out) Configuration ---
# These values MUST correspond to the configuration of your SAML Identity Provider (IdP).
# For local development, this is likely the `docker-simple-saml` project.
SAML_ENVIRONMENT=LOCAL
SAML_ISSUER=http://localhost:8070
# Route defined under routes/auth.js
SAML_CALLBACK_URL=http://localhost:8070/auth/saml/callback
# absolute path to the file docker-simple-saml/cert/server.pem
SAML_PRIVATE_KEY_PATH=/path/to/server.pem
# absolute path to the file docker-simple-saml/cert/server.crt
SAML_CERT_PATH=/path/to/server.crt

# MONGO_DB Configs
MONGODB_URI=mongodb://username:password@localhost:27017
MONGODB_DB_NAME=tlef_grasp
 
# LLM Configs
# LLM_PROVIDER selects the provider + models, independent of NODE_ENV:
#   ollama -> local Ollama (OLLAMA_* models), openai -> OpenAI (OPENAI_* models). Defaults to openai when unset.
LLM_PROVIDER=ollama
# Models are picked per provider: OLLAMA_* used when LLM_PROVIDER=ollama, OPENAI_* when openai.

# --- Provider connection details ---
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_ENDPOINT=http://localhost:11434

# --- Reasoning effort ---
# The newer OpenAI models take `reasoning_effort` instead of a temperature (they
# reject an explicit temperature outright). Effort buys quality with latency, so
# every operation defaults to "high"; lower the ones not worth waiting for.
# Note this covers document parsing and outline generation too, which run on
# every material upload — those are the first to dial down if uploads feel slow.
# Accepted values: none, minimal, low, medium, high. An unrecognised value is
# ignored with a warning, so a typo cannot fail a request.
#
# These are the DEPLOYMENT default. A course owner can override any stage from
# Settings -> AI Generation, and their choice wins for that course; these values
# apply to every course that has expressed no preference.
#
# Global default for every operation:
#LLM_REASONING_EFFORT=high
#
# Per-operation overrides, which win over the global default. The suffix is the
# operation label from the usage log, upper-cased with dashes as underscores:
#LLM_EFFORT_QUESTION_GENERATE=high
#LLM_EFFORT_QUESTION_REVIEW=high
#LLM_EFFORT_QUESTION_FIX=high
#LLM_EFFORT_OBJECTIVE_GENERATE=medium
#LLM_EFFORT_GRADE_OPEN_ENDED=high
#LLM_EFFORT_GRADE_FILL_IN_THE_BLANK=high
#LLM_EFFORT_OUTLINE_BATCH=medium
#LLM_EFFORT_OUTLINE_CONSOLIDATE=medium
#LLM_EFFORT_PDF_PAGE_IMAGE=medium
#LLM_EFFORT_PPTX_SLIDE_IMAGE=medium
#
# On Ollama there is no equivalent control, so effort maps to sampling
# temperature instead (high -> 0.1, medium -> 0.3, low/minimal/none -> 0.5+).

# --- LLM concurrency: read this before tuning the two blocks below ---
# BOTH limits are PER WORKER PROCESS, not per deployment and not per course.
# server.js forks one worker per CPU core in production (capped at 4, override
# with GRASP_WEB_CONCURRENCY), and each worker holds its own independent pool.
# So the real ceiling is workers x the value set here:
#
#   workers   GRADING_LLM_CONCURRENCY=32   GENERATION_LLM_CONCURRENCY=6
#   1         32 in flight                 6 in flight
#   4         128 in flight                24 in flight
#
# Divide by your worker count to get a deployment-wide ceiling: with 4 workers,
# GRADING_LLM_CONCURRENCY=8 is what actually caps grading at 32.
#
# Neither pool is scoped to a course. Within a worker, every course and every
# user shares the same pool, so one instructor generating 40 objectives can
# occupy the generation pool while another instructor's request queues behind
# it (it waits rather than fails — the generation pool never sheds).
#
# The two pools are independent of each other: a generation run cannot consume
# grading slots, so students mid-quiz are not starved by an instructor's batch.
# They do share your provider's token budget, which nothing here can partition.

# --- Grading concurrency (per worker) ---
# Grading runs inside the student's answer-check request, so a shed call is not
# a delay: the answer is saved ungraded and the instructor grades it by hand.
# Sizing assumes a whole class answering at once. At ~1.7s per call, 32 drains
# a 1,000-student burst in under a minute; the queue timeout is a safety valve,
# not the normal path. Grading prompts are small, so width is cheap here.
#GRADING_LLM_CONCURRENCY=32
#GRADING_LLM_QUEUE_TIMEOUT_MS=60000
#GRADING_LLM_TIMEOUT_MS=30000
#GRADING_LLM_MAX_RETRIES=2

# --- Generation concurrency (per worker) ---
# Question generation runs one request per GRANULAR objective — granulars from
# different parent objectives run together in one flat pool. Those requests are
# independent, so they run concurrently; these bound how many.
#
# Server-side cap on in-flight provider calls made by generation — shared across
# generation, review, fix and RAG retrieval so they cannot each saturate the
# provider independently. Lower this first if you see 429s.
#GENERATION_LLM_CONCURRENCY=6
# Generation calls are long: p90 is around 41s at high reasoning effort, so this
# is deliberately far above the grading equivalent.
#GENERATION_LLM_TIMEOUT_MS=120000
#GENERATION_LLM_MAX_RETRIES=3
#
# The client pool halves its own concurrency for the rest of a run whenever the
# server answers 429, and stops the run after 5 consecutive rate-limit
# failures (immediately on 401/403). Setting the client to 1 restores the old
# sequential behaviour.
#
# That pool lives in the browser, so its limit and its circuit breaker are per
# open tab: two instructors generating at once are two independent pools, and
# their requests may land on different workers with independent server pools.
#
# Client build-time variable — Vite inlines VITE_* values into the bundle at
# `npm run build`, so this must be set wherever the client is built, not just
# wherever the server runs, and a change requires a rebuild to take effect.
#VITE_GENERATION_CONCURRENCY=4

# --- Production models (OpenAI) ---
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_REVIEW_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vision model for transcribing images in PDFs. Optional — defaults to OPENAI_LLM_MODEL if unset.
OPENAI_VISION_MODEL=gpt-5.4-mini

# --- Development models (Ollama) ---
# Use models you have pulled locally. The embedding model must match
# QDRANT_VECTOR_SIZE below (e.g. nomic-embed-text -> 768).
OLLAMA_LLM_MODEL=Qwen3:0.6B
OLLAMA_REVIEW_MODEL=Qwen3:0.6B
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Vision model for transcribing images in PDFs. Optional — defaults to OLLAMA_LLM_MODEL if unset.
# Must be a multimodal model (e.g. qwen2.5vl, llava, gemma3:4b); pull it first.
OLLAMA_VISION_MODEL=qwen2.5vl:7b

EMBEDDING_PROVIDER=ubc-genai-toolkit-llm

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=question-generation-collection
QDRANT_API_KEY=your_qdrant_api_key_here
# Vector size per stage — must match the embedding model's output dimension.
OPENAI_QDRANT_VECTOR_SIZE=1536
OLLAMA_QDRANT_VECTOR_SIZE=768

# --- RAG retrieval ---
# Each limit below is a TOTAL chunk budget, split evenly across the materials
# attached to a learning objective. Every material is guaranteed a share, so
# attaching more materials does not increase token cost.

# Objective generation FALLBACK only. Objective generation normally reads each
# material's stored outline; this budget applies when a selected material has no
# outline yet. Chunks are capped at 1000 chars each, so 200 tops out near 200k
# chars. Objective generation applies no score threshold.
RAG_OBJECTIVE_CHUNK_LIMIT=200

# --- LLM usage accounting ---
# On by default. Every LLM call (question generation, outlines, PDF/PPTX image
# transcription, answer grading) appends one JSON line recording operation,
# model, token counts and duration. Read it with `npm run usage`.
# Token counts are recorded; dollars are computed at read time, so correcting the
# price table fixes historical reports too.
# Set to false (also accepted: 0, no, off) to turn it off.
#LLM_USAGE_LOG_ENABLED=false
# Where those lines go. Defaults to logs/llm-usage.jsonl under the project root.
#LLM_USAGE_LOG=logs/llm-usage.jsonl

# Question generation. Renamed from RAG_CHUNK_LIMIT / RAG_SCORE_THRESHOLD, which
# read as global but only ever applied here. The old names are no longer read —
# update any deployment that still sets them.
#
# This is the dominant cost in question generation: the retrieved material sits
# in the prefix every request in a batch opens with, so each chunk is paid for
# roughly once per question generated, plus once per fix — around 80% of a
# batch's input at this value.
#
# Remember it is a TOTAL split across the materials on an objective (at most 3),
# so 50 means 50 chunks for a single-material objective but ~17 each for three.
#
# It is a ceiling, not a target: only chunks clearing the threshold below are
# retrieved, so a narrow objective costs less without this changing.
RAG_QUESTION_CHUNK_LIMIT=50
# Review -> fix cycles per flagged question (default 2). Each cycle replays the
# question's whole context, so this is the most expensive knob in that loop. Its
# value is limited while the re-review does not verify the original issue: a
# patch that did not resolve what was flagged is cleared anyway and never reaches
# a second cycle.
#REVIEW_FIX_MAX_CYCLES=2

# Minimum similarity score for a chunk. A material that returns nothing at this
# threshold is retried WITHOUT it, per material — so a threshold set too high for
# the embedding model does not trim anything, it just adds a wasted round trip
# and hands back the full ceiling. Watch for
#   "Score threshold 0.6 returned 0 chunks ... retrying without threshold"
# in the server log: if that fires for most materials, lower this (OpenAI
# embeddings put genuinely relevant passages nearer 0.3-0.5 than 0.6) rather
# than lowering the chunk limit to compensate.
RAG_QUESTION_SCORE_THRESHOLD=0.6

# Course Lookup
UBC_API_ENV=prod
UBC_API_CLIENT_ID=your_ubc_api_client_id_here
UBC_API_CLIENT_SECRET=your_ubc_api_client_secret_here

# --- Canvas LMS OAuth (optional) ---
# Canvas controls are hidden unless all four values are present. The redirect
# URI must exactly match the URI registered on the Canvas Developer Key.
CANVAS_DOMAIN=ubc.instructure.com
CANVAS_CLIENT_ID=your_canvas_developer_key_id
CANVAS_CLIENT_SECRET=your_canvas_developer_key_secret
CANVAS_REDIRECT_URI=http://localhost:8070/api/lms/canvas/auth/callback

# --- Moodle LMS token connection (optional) ---
# Moodle controls are hidden when this value is absent. Instructors paste
# their own Moodle web-service token from the Settings page.
MOODLE_DOMAIN=http://localhost:9200
